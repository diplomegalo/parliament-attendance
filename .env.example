# Parliament Attendance - Environment Configuration

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parliament_attendance
DB_USER=parliament
DB_PASSWORD=your_password_here

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose ONE of the following LLM providers:

# Option 1: OpenAI (Recommended for getting started)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: Azure OpenAI Service (Enterprise, EU data residency)
# Get credentials from Azure Portal
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_key_here

# Option 3: Anthropic Claude (Alternative to OpenAI - Coming Soon)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 4: Ollama (Local LLM, free but slower - Coming Soon)
# OLLAMA_HOST=http://localhost:11434

# =============================================================================
# Job Configuration
# =============================================================================
# Legislature number to process
LEGISLATURE=56

# Specific minute reference to process (optional, for single minute)
# MINUTE_REF=0001

# Reprocess already computed attendance (set to "true" to reprocess)
# REPROCESS=false

# Fuzzy name matching threshold (0-100, default: 85)
FUZZY_MATCH_THRESHOLD=85

# =============================================================================
# Storage Configuration
# =============================================================================
# Local storage path for content files
# STORAGE_PATH=./data/minutes/

# Azure Blob Storage (optional, for cloud storage)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
# AZURE_STORAGE_CONTAINER=parliamentary-minutes
