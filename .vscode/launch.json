{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Containers: Python - General",
            "type": "docker",
            "request": "launch",
            "preLaunchTask": "docker-run: debug",
            "python": {
                "pathMappings": [
                    {
                        "localRoot": "${workspaceFolder}",
                        "remoteRoot": "/app"
                    }
                ],
                "projectType": "general"
            }
        },

        // Python: debug unittests (discover)
        {
            "name": "Debug Unittests (discover)",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "backend/tests", "-p", "test_*.py"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "LOG_LEVEL": "DEBUG",
                "PYTHONPATH": "${workspaceFolder}"
            }
        },

        // Python: debug a single test by dotted name
        {
            "name": "Debug single test (dotted name)",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["backend.tests.test_textintegral.TestTextIntegral.test_fetch_minister"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "LOG_LEVEL": "DEBUG",
                "PYTHONPATH": "${workspaceFolder}"
            }
        },

        // Python: run current file
        {
            "name": "Run current file (python)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "LOG_LEVEL": "DEBUG",
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}